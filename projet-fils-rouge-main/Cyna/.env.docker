# Configuration utilisée DANS le conteneur Docker (montée sur /var/www/html/.env).
# Le fichier .env (racine) reste, lui, dédié au lancement via XAMPP.
#
# IMPORTANT : ce fichier est versionné et ne doit JAMAIS contenir de secret réel
# (mot de passe SMTP, clé Stripe secrète, etc.). Il fournit une configuration de
# développement/test fonctionnelle « clé en main ».
APP_ENV=local
APP_NAME="Cyna"
APP_URL=http://localhost:8080
APP_LOCALE=fr
APP_LOCALES=fr,en

# --- Base de données : "db" est le nom du service MySQL dans docker-compose ---
DB_HOST=db
DB_PORT=3306
DB_NAME=bsi
DB_USER=sentryx
DB_PASSWORD=sentryx_secret

# --- E-mails : capturés par Mailpit (serveur SMTP de test) ------------------
# Les e-mails ne partent PAS vers de vraies boîtes : ils sont consultables sur
# l'interface web http://localhost:8025 (on peut y cliquer le lien de
# confirmation d'inscription). C'est le comportement attendu en local.
#
# Pour un envoi RÉEL (démo en direct ou déploiement serveur), NE PAS modifier ce
# fichier : renseigner ses identifiants SMTP dans un fichier .env local NON
# versionné, ou via des variables d'environnement du serveur.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS=no-reply@cyna-it.fr
MAIL_FROM_NAME="Cyna"

# --- Stripe (vide = paiement simulé) ---
# La clé secrète réelle ne doit jamais être versionnée : la renseigner dans un
# .env local non suivi par Git.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=eur

# --- Sécurité ---
TOTP_ISSUER=Cyna

# Comptes de démonstration (après import du seed) :
#   Administrateur : admin@cyna-it.fr / Admin@1234  (2FA à configurer au 1er accès)
#   Client         : client@cyna-it.fr / Client@1234
