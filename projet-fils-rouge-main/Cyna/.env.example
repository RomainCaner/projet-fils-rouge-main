# ---------------------------------------------------------------------------
# Configuration d'environnement CYNA — copier ce fichier en `.env` et adapter.
# Le fichier `.env` n'est JAMAIS committé (cf. .gitignore).
# ---------------------------------------------------------------------------

# Environnement applicatif : "local" (debug activé) ou "production"
APP_ENV=local
APP_NAME="Cyna"
# URL publique du site (sans slash final), utilisée pour les liens des emails
APP_URL=http://localhost:8080
# Langue par défaut (fr|en) et liste des langues activées
APP_LOCALE=fr
APP_LOCALES=fr,en

# --- Base de données MySQL (le conteneur Docker fournit l'hôte "mysql") ------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=cyna
DB_USER=cyna
DB_PASSWORD=change_me

# --- Serveur SMTP (conteneur de test type Mailpit/MailHog) ------------------
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# tls|ssl|none — "none" pour un serveur de test local
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS=no-reply@cyna-it.fr
MAIL_FROM_NAME="Cyna"

# --- Paiement Stripe (mode test : clés "sk_test_..." / "pk_test_...") -------
# Laisser vide pour ne pas activer les appels réseau réels.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=eur

# --- Sécurité ---------------------------------------------------------------
# Clé aléatoire (32+ caractères) servant aux signatures internes / "remember me"
APP_KEY=
# Émetteur affiché dans les applications TOTP (2FA admin)
TOTP_ISSUER=Cyna
